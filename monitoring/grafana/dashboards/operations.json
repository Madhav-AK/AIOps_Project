{
  "uid": "fraud-operations",
  "title": "Fraud detection operations",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "Component health: 1 = up; missing = unobserved",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "aiops_service_up{component!~\"prometheus|grafana\"} and on(job,instance) (up{job=\"backend\"} == 1)",
          "legendFormat": "{{component}}",
          "range": false,
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aiops_worker_up",
          "legendFormat": "operations worker",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Prediction requests and errors / second",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aiops_http_requests_total{route=\"/predict\"}[1m]))",
          "legendFormat": "all predictions",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum(rate(aiops_http_requests_total{route=\"/predict\",status!~\"2..\"}[1m]))",
          "legendFormat": "prediction errors",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum(rate(aiops_http_requests_total{route=\"/predict\",client=\"frontend\"}[1m]))",
          "legendFormat": "from Streamlit",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "title": "Prediction p95 latency",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(aiops_http_request_seconds_bucket{route=\"/predict\"}[1m])))",
          "legendFormat": "API total",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by(le) (rate(aiops_model_inference_seconds_bucket[1m])))",
          "legendFormat": "MLflow round trip",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "title": "Amount drift (PSI) and configured threshold",
      "type": "timeseries",
      "description": "Last 200 valid predictions, minimum 100. Empty before minimum; input shift is not evidence of quality loss.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_amount_psi",
          "legendFormat": "amount PSI",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "aiops_drift_threshold",
          "legendFormat": "threshold",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "title": "Firing alerts (empty means none)",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "legendFormat": "{{alertname}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "title": "Last labelled replay \u2014 precision / recall / F1",
      "type": "stat",
      "description": "Known labels are used by the replay client only. These are the last completed replay results for the active model, not immediate production labels.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_labelled_replay{metric=~\"precision|recall|f1\"}",
          "legendFormat": "{{metric}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "title": "Latest recorded DVC step time",
      "type": "timeseries",
      "description": "Includes cached rerun timing when execution=reused. Use the actual Ray throughput panel for processing speed.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_pipeline_stage_seconds",
          "legendFormat": "{{stage}} ({{execution}})",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Last actual Ray preparation throughput",
      "type": "stat",
      "description": "Full preparation wall time includes startup, CSV processing, splitting and Parquet writes.",
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_preparation_rows_per_second",
          "legendFormat": "rows / second",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "title": "Backend CPU and memory availability",
      "type": "stat",
      "description": "",
      "gridPos": {
        "x": 8,
        "y": 26,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"backend\"}[1m]) * 100",
          "legendFormat": "backend CPU (% of one core)",
          "range": false,
          "instant": true
        },
        {
          "refId": "B",
          "expr": "process_resident_memory_bytes{job=\"backend\"} / 1024 / 1024",
          "legendFormat": "backend RSS (MiB)",
          "range": false,
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aiops_machine_available_memory_bytes / 1024 / 1024 / 1024",
          "legendFormat": "available machine RAM (GiB)",
          "range": false,
          "instant": true
        },
        {
          "refId": "D",
          "expr": "aiops_disk_free_bytes / 1024 / 1024 / 1024",
          "legendFormat": "free disk (GiB)",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "title": "Recorded operations: successes and failures",
      "type": "table",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_recorded_jobs",
          "legendFormat": "{{kind}} / {{state}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 20,
      "title": "Active model / reference",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aiops_model_info",
          "legendFormat": "{{model_uri}} / training run {{reference_run_id}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "name",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "Observed model behaviour: flags and mean score",
      "description": "Observed predictions only; scores are not calibrated probabilities and these do not supply fraud labels.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(aiops_predictions_total{label=\"Flag for review\"}[1m])) / sum(rate(aiops_predictions_total[1m]))",
          "legendFormat": "flagged fraction",
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(aiops_fraud_score_sum[1m]) / rate(aiops_fraud_score_count[1m])",
          "legendFormat": "mean score",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
